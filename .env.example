# ─────────────────────────────────────────────
# NeuralOps — Environment Configuration Example
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# LLM Provider Selection
LLM_PROVIDER=groq

# API Keys
GROQ_API_KEY=
MISTRAL_API_KEY=
# Local app default: http://localhost:11434
# Compose default: http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///./neuralops_dev.db

# Application
NEURALOPS_PORT=8000
NEURALOPS_ENVIRONMENT=development
SECRET_KEY=change_me_in_production_generate_with_secrets_module

# Judge Settings
JUDGE_MODEL=llama-3.3-70b-versatile
JUDGE_BACKEND=groq
EXPERIMENT_SIGNIFICANCE_LEVEL=0.05

# Drift Detection
DRIFT_ALERT_THRESHOLD=6.5
DRIFT_CHECK_INTERVAL_MINUTES=60

# Guardrails
TOXICITY_THRESHOLD=0.7
PII_ENABLED=true
TOXICITY_DEVICE=cpu

# Telegram Alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
DASHBOARD_API_URL=http://localhost:8000
